# Copy to .env.prod and edit. The app always authenticates against a real Keycloak.
#
# These variables are consumed by vite.config.ts to configure the dev-server PROXY
# (the browser only ever talks to the Vite origin at :5173, which proxies to the
# backends — so the API hosts/keys below are NEVER embedded in the browser bundle).
# Only variables WITH a VITE_ prefix are exposed to the browser via import.meta.env.
#
# IMPORTANT: .env.prod is gitignored because it holds a real NVIDIA_API_KEY.
# Never commit it with real values.

# ── Division agent API servers (proxy targets — never exposed to the browser) ────
# The two panes (Cluster A / Cluster B) each target one division's agent. In this
# product both panes speak the SAME AGT contract (POST /query, status/result/done
# SSE) — they differ only by which physically-isolated division they hit.
# Live local divisions: alpha agent = 9000, beta agent = 9100.
AGT_A_URL=http://127.0.0.1:9000
AGT_B_URL=http://127.0.0.1:9100

# ── Keycloak (the OIDC issuer each division authenticates against) ───────────────
# Base URL only (no realm/path suffix). Live: alpha kc = 9002, beta kc = 9102.
# MUST be `localhost` (not 127.0.0.1): Keycloak reflects the request Host into the
# token's `iss`, and each division's agent only accepts iss=http://localhost:<kc>/realms/rag
# (its OIDC_ISSUER). With changeOrigin:true the proxy presents the target Host to
# Keycloak, so the target host == the issuer host the agent expects.
KEYCLOAK_A_URL=http://localhost:9002
KEYCLOAK_B_URL=http://localhost:9102

# Keycloak realm names (the OIDC realm the UI authenticates against)
REALM_A=rag
REALM_B=rag

# ── LLM proxy (OpenAI-compatible endpoint; key injected server-side by Vite) ─────
# Browser → /nvidia → this endpoint; the key is added by the proxy, never bundled.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# Model identifier sent in LLM requests (VITE_ so the browser can read it)
VITE_NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Pane display labels (VITE_ so the browser renders them in the headers) ───────
VITE_CLUSTER_A_LABEL=Division Alpha (alice)
VITE_CLUSTER_B_LABEL=Division Beta (bob)

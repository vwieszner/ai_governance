# Copy to .env.prod and edit. The app always authenticates against a real Keycloak.
# Variables WITHOUT a VITE_ prefix are consumed by vite.config.ts (server-side
# proxy configuration only) and are NOT embedded in the browser bundle.
# Variables WITH a VITE_ prefix are also exposed to the browser via import.meta.env.
#
# IMPORTANT: .env.prod is listed in .gitignore because it contains real secrets
# (NVIDIA_API_KEY, A2A_SHARED_SECRET). Never commit it with real values.

# ── Cluster API servers (proxy targets — never exposed to the browser) ──────────

# federated-rag (cluster-a) API server
CLUSTER_A_URL=http://localhost:8000

# agt-federated-rag (cluster-b) API server
CLUSTER_B_URL=http://localhost:8002

# ── Keycloak (set to cluster URL in mock-auth mode, real Keycloak in production) ─

# Keycloak base URL (server root, no realm or path suffix)
KEYCLOAK_A_URL=http://localhost:8080
KEYCLOAK_B_URL=http://localhost:8080

# Keycloak realm names (the OIDC realm the UI authenticates against)
REALM_A=rag
REALM_B=rag

# ── LLM proxy (OpenAI-compatible endpoint; key injected server-side) ─────────────

# Base URL for the LLM API (proxied under /nvidia — key is never in the bundle)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# API key for the LLM endpoint
NVIDIA_API_KEY=

# Model identifier sent in LLM requests (VITE_ so the browser can read it)
VITE_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ── Cluster display labels (VITE_ so the browser renders them in pane headers) ───

VITE_CLUSTER_A_LABEL=Cluster A
VITE_CLUSTER_B_LABEL=Cluster B

# ── Security / CORS (server-side only) ───────────────────────────────────────────

# Comma-separated list of allowed CORS origins for the cluster API servers.
# Example: http://localhost:5173,https://rag.example.com
CORS_ORIGINS=http://localhost:5173

# Shared secret for Agent-to-Agent (A2A) calls between clusters.
# Must match across all cluster servers. Keep this secret — never use VITE_ prefix.
A2A_SHARED_SECRET=

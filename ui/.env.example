# Copy to .env.prod and edit. The app always authenticates against a real Keycloak.
#
# These variables are consumed by vite.config.ts to configure the dev-server PROXY
# (the browser only ever talks to the Vite origin at :5173, which proxies to the
# backends — so the API hosts/keys below are NEVER embedded in the browser bundle).
# Only variables WITH a VITE_ prefix are exposed to the browser via import.meta.env.
#
# IMPORTANT: .env.prod is gitignored because it holds a real NVIDIA_API_KEY.
# Never commit it with real values.

# ── Division agent API servers (proxy targets — never exposed to the browser) ────
# The two panes (Cluster A / Cluster B) each target one division's agent. In this
# product both panes speak the SAME AGT contract (POST /query, status/result/done
# SSE) — they differ only by which physically-isolated division they hit.
# Live local divisions: alpha agent = 9000, beta agent = 9100.
AGT_A_URL=http://127.0.0.1:9000
AGT_B_URL=http://127.0.0.1:9100

# ── Keycloak (the OIDC issuer each division authenticates against) ───────────────
# Base URL only (no realm/path suffix). Live: alpha kc = 9002, beta kc = 9102.
# MUST be `localhost` (not 127.0.0.1): Keycloak reflects the request Host into the
# token's `iss`, and each division's agent only accepts iss=http://localhost:<kc>/realms/rag
# (its OIDC_ISSUER). With changeOrigin:true the proxy presents the target Host to
# Keycloak, so the target host == the issuer host the agent expects.
KEYCLOAK_A_URL=http://localhost:9002
KEYCLOAK_B_URL=http://localhost:9102

# Keycloak realm names (the OIDC realm the UI authenticates against)
REALM_A=rag
REALM_B=rag

# ── LLM proxy (OpenAI-compatible endpoint; key injected server-side by Vite) ─────
# Browser → /nvidia → this endpoint; the key is added by the proxy, never bundled.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# Model identifier sent in LLM requests (VITE_ so the browser can read it)
VITE_NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Divisions (the UI is division-native and N-capable) ──────────────────────────
# The UI models divisions as a configurable list, NOT a hardcoded pair. With nothing
# set below, the bundled two-division demo (alpha + beta) is used.
#
# To run N divisions, set VITE_DIVISIONS to a JSON array (VITE_ so the browser reads it).
# Each entry needs at least id + apiBase + authBase; label/defaultUser/clientId default.
# Add a matching proxy entry in vite.config.ts for each apiBase/authBase you introduce.
# Example (three divisions):
# VITE_DIVISIONS=[{"id":"alpha","label":"Division Alpha (alice)","defaultUser":"alice","apiBase":"/api/agt-a","authBase":"/auth/a"},{"id":"beta","label":"Division Beta (bob)","defaultUser":"bob","apiBase":"/api/agt-b","authBase":"/auth/b"},{"id":"gamma","label":"Division Gamma","defaultUser":"carol","apiBase":"/api/agt-c","authBase":"/auth/c"}]
VITE_DIVISIONS=

# Back-compat: relabel the two DEFAULT divisions (ignored when VITE_DIVISIONS is set).
VITE_CLUSTER_A_LABEL=Division Alpha (alice)
VITE_CLUSTER_B_LABEL=Division Beta (bob)

# ── Login mode ──────────────────────────────────────────────────────────────────
# "password" = the two-pane split view (Keycloak password grant; tokens in React memory).
# "bff"      = PRODUCTION auth (recommended): one division per browser session. Login is a
#              server-side OIDC Auth-Code + PKCE flow at the agent's /bff/* endpoints; the
#              browser holds ONLY an HttpOnly session cookie — NO access/refresh token ever
#              reaches JS (XSS can't steal it), with server-side silent refresh + CSRF.
#              Each user logs in from their own browser; open the other division separately.
# "pkce"     = OIDC Auth-Code + PKCE in the SPA (tokens in the browser; weaker than bff —
#              kept for reference). Set the VITE_OIDC_* vars below if used.
VITE_AUTH_MODE=password
# OIDC issuer (authority) — discovery is read from <authority>/.well-known/openid-configuration
VITE_OIDC_AUTHORITY=
# Public SPA client id registered at the IdP (no client secret used)
VITE_OIDC_CLIENT_ID=rag-ui
# Redirect URI registered at the IdP; defaults to the app origin + "/"
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_SCOPE=openid email profile

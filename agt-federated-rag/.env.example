# ── Cluster identity ──────────────────────────────────────────────────────────
CLUSTER_ID=cluster-a
AGENT_NAME="AGT RAG Agent - Cluster A"
AGENT_URL=https://agent-a.internal

# ── Peer cluster ──────────────────────────────────────────────────────────────
PEER_AGENT_URL=https://agent-b.internal
# Get both values from the peer's GET /identity endpoint at setup time.
PEER_AGENT_DID=did:mesh:cluster-b-rag-agent-xxxx
# Peer's public-key JWK (compact JSON) — used to verify the Ed25519 signature on
# inbound peer callbacks. Example: {"kty":"OKP","crv":"Ed25519","x":"...","kid":"did:mesh:...","use":"sig"}
PEER_AGENT_PUBLIC_JWK=

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=nvapi-xxxx
LLM_MODEL=meta/llama-3.3-70b-instruct

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ── OpenFGA ───────────────────────────────────────────────────────────────────
OPENFGA_API_URL=http://openfga:8080
OPENFGA_STORE_ID=         # run scripts/setup-openfga.py
OPENFGA_MODEL_ID=         # run scripts/setup-openfga.py

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=approval-queue

# ── OIDC / JWT (Keycloak — user authentication) ───────────────────────────────
OIDC_ISSUER=https://keycloak.internal/realms/rag
OIDC_JWKS_URI=https://keycloak.internal/realms/rag/protocol/openid-connect/certs
AGENT_CLIENT_ID=agent-cluster-a
AGENT_CLIENT_SECRET=change-me

# ── AgentMesh (Microsoft Agent Governance Toolkit — agent identity) ───────────
# The agent's DID + Ed25519 keypair is created via agentmesh.AgentIdentity.create().
# AGENT_SPONSOR_EMAIL is the human sponsor bound to the DID (required by the toolkit).
AGENT_SPONSOR_EMAIL=ops@your-domain.com
AGENT_MESH_REGISTRY_URL=http://mesh-registry:9000
AGENT_TRUST_THRESHOLD=0.6

# ── AGT Policy Engine ─────────────────────────────────────────────────────────
POLICY_DIR=agent/policies
POLICY_AUDIT_ONLY=false   # set true to log-only without blocking (useful in staging)

# ── AGT Agent SRE ─────────────────────────────────────────────────────────────
SRE_ENABLED=true
SRE_SLO_LATENCY_P99_MS=5000.0
SRE_ERROR_BUDGET_PERCENT=0.1

# ── Approval HMAC ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_HMAC_SECRET=change-me-generate-32-byte-hex

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-
SLACK_APPROVAL_CHANNEL=#approvals
APPROVAL_UI_BASE_URL=https://approval.internal

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

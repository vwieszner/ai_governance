# ── Cluster identity ──────────────────────────────────────────────────────────
CLUSTER_ID=cluster-a                        # cluster-a or cluster-b
AGENT_NAME="RAG Agent - Cluster A"
AGENT_URL=https://agent-a.internal          # public A2A base URL for this agent

# ── Peer agent (the other cluster) ───────────────────────────────────────────
PEER_AGENT_URL=https://agent-b.internal     # base URL of the peer cluster agent
PEER_AGENT_CARD_URL=https://agent-b.internal/.well-known/agent-card.json

# ── LLM (NVIDIA NIM / any OpenAI-compatible endpoint) ────────────────────────
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=nvapi-xxxx
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5     # optional — falls back to BGE-M3 via FastEmbed

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── OpenFGA ───────────────────────────────────────────────────────────────────
OPENFGA_API_URL=http://openfga:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=approval-queue

# ── OIDC / JWT (Keycloak) ─────────────────────────────────────────────────────
OIDC_ISSUER=https://keycloak.internal/realms/rag
OIDC_JWKS_URI=https://keycloak.internal/realms/rag/protocol/openid-connect/certs
OIDC_TOKEN_ENDPOINT=https://keycloak.internal/realms/rag/protocol/openid-connect/token
AGENT_CLIENT_ID=agent-cluster-a
AGENT_CLIENT_SECRET=secret

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-
SLACK_APPROVAL_CHANNEL=#approvals
APPROVAL_UI_BASE_URL=https://approval.internal

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
